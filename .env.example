FOFU_ENVIRONMENT=local
FOFU_DATABASE_URL=sqlite:///./fofu.db
FOFU_JWT_SECRET=replace-with-at-least-32-random-characters
# JSON array of OAuth client IDs accepted in Google ID-token `aud` claims.
# For iOS backend auth, add the full Web application client ID also used as GIDServerClientID.
FOFU_GOOGLE_OAUTH_CLIENT_IDS=[]
# APNs is fail-closed. Leave disabled locally, or mount the .p8 key outside the repo
# and configure every field below for a real iOS environment.
FOFU_APNS_ENABLED=false
FOFU_APNS_ENVIRONMENT=sandbox
FOFU_APNS_TEAM_ID=
FOFU_APNS_KEY_ID=
FOFU_APNS_BUNDLE_ID=
FOFU_APNS_PRIVATE_KEY_PATH=
FOFU_PUSH_WORKER_POLL_SECONDS=2
FOFU_PUSH_WORKER_BATCH_SIZE=20
FOFU_PUSH_DELIVERY_MAX_ATTEMPTS=8
FOFU_PUSH_DELIVERY_LEASE_SECONDS=60
FOFU_PUSH_DELIVERY_RETENTION_DAYS=30
FOFU_PUSH_MAX_ACTIVE_DEVICES_PER_USER=10
FOFU_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FOFU_WEB_APP_BASE_URL=http://localhost:3000
FOFU_PUBLIC_API_BASE_URL=http://localhost:8000
FOFU_UPLOAD_DIR=./var/uploads
FOFU_AUTO_CREATE_SCHEMA=true
FOFU_SEED_DEMO_DATA=true
