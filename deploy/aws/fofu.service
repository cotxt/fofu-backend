[Unit]
Description=Fofu production API containers
Documentation=file:///opt/fofu/docs/AWS_EC2_DEPLOYMENT.md
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s
WorkingDirectory=/opt/fofu
Environment=AWS_REGION=ap-northeast-2
Environment=FOFU_CONFIG_FILE=/etc/fofu/production.env
Environment=FOFU_COMPOSE_FILE=/opt/fofu/deploy/aws/compose.production.yaml
Environment=FOFU_DATABASE_URL_PARAMETER=/fofu/production/database-url
Environment=FOFU_JWT_SECRET_PARAMETER=/fofu/production/jwt-secret
ExecStart=/opt/fofu/deploy/aws/compose-with-ssm.sh up --detach --build --remove-orphans --wait --wait-timeout 300
ExecReload=/opt/fofu/deploy/aws/compose-with-ssm.sh up --detach --build --remove-orphans --wait --wait-timeout 300
ExecStop=/opt/fofu/deploy/aws/compose-with-ssm.sh down --timeout 30
TimeoutStartSec=20min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
