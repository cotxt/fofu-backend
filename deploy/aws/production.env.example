# Copy this file to /etc/fofu/production.env on the EC2 instance.
# It intentionally contains no secrets. Do not add FOFU_DATABASE_URL or
# FOFU_JWT_SECRET here; compose-with-ssm.sh reads them from SecureString values.

# Hostname only: no https:// prefix and no trailing path.
FOFU_DOMAIN=api.example.com
FOFU_TLS_EMAIL=ops@example.com

FOFU_ENVIRONMENT=production
FOFU_CORS_ORIGINS=["https://app.example.com"]
FOFU_WEB_APP_BASE_URL=https://app.example.com
FOFU_PUBLIC_API_BASE_URL=https://api.example.com
FOFU_GOOGLE_OAUTH_CLIENT_IDS=[]

FOFU_UPLOAD_DIR=/app/var/uploads
FOFU_AUTO_CREATE_SCHEMA=false
FOFU_SEED_DEMO_DATA=false

# Keep APNs off for the first deployment. Enabling it also requires mounting a
# private .p8 key and setting every FOFU_APNS_* identifier.
FOFU_APNS_ENABLED=false
FOFU_APNS_ENVIRONMENT=production
FOFU_APNS_TEAM_ID=
FOFU_APNS_KEY_ID=
FOFU_APNS_BUNDLE_ID=
FOFU_APNS_PRIVATE_KEY_PATH=

FOFU_PUSH_WORKER_POLL_SECONDS=2
FOFU_PUSH_WORKER_BATCH_SIZE=20
FOFU_PUSH_DELIVERY_MAX_ATTEMPTS=8
FOFU_PUSH_DELIVERY_LEASE_SECONDS=60
FOFU_PUSH_DELIVERY_RETENTION_DAYS=30
FOFU_PUSH_MAX_ACTIVE_DEVICES_PER_USER=10
